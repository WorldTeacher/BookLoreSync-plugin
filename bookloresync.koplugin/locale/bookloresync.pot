msgid "Configure WiFi connection behavior for sync actions."
msgstr ""

#: bookloresync.koplugin/main.lua:4187
msgid "WiFi connect timeout (seconds) (%1)"
msgstr ""

#: bookloresync.koplugin/main.lua:4189
msgid ""
"How long to wait for WiFi to become connected after enabling it, before "
"giving up. Increase this on slower devices."
msgstr ""

#: bookloresync.koplugin/main.lua:4199
msgid "Sync delay after connect"
msgstr ""

#: bookloresync.koplugin/main.lua:4200
msgid ""
"Wait this many seconds after network becomes connected before running sync "
"requests. Useful on devices where routing/DNS is not immediately ready after "
"WiFi connect."
msgstr ""

#: bookloresync.koplugin/main.lua:4207
msgid "Run until connect"
msgstr ""

#: bookloresync.koplugin/main.lua:4208
msgid ""
"Disable plugin-side connect timeout and wait until WiFi connects or the "
"underlying network stack times out on its own."
msgstr ""

#: bookloresync.koplugin/main.lua:4222
msgid "Automatic (sync on suspend when connected)"
msgstr ""

#: bookloresync.koplugin/main.lua:4223
msgid ""
"Automatically sync sessions on suspend and resume only when WiFi is already "
"connected. The plugin does not enable WiFi on suspend; if disconnected, data "
"stays queued until the next sync trigger."
