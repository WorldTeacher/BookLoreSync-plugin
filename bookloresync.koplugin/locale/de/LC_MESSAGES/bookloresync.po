msgstr "Sync fehlgeschlagen: ungültige Regaldaten"

#: bookloresync.koplugin/booklore_shelf_sync.lua:521
msgid "Shelf up to date - nothing to do"
msgstr "Regal ist aktuell - nichts zu tun"

#: bookloresync.koplugin/booklore_shelf_sync.lua:523
msgid "Syncing shelf: %1 new, %2 removed"
msgstr "Regal wird synchronisiert: %1 neu, %2 entfernt"

#: bookloresync.koplugin/booklore_shelf_sync.lua:543
