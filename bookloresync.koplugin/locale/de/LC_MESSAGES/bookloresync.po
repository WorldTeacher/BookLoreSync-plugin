msgstr "Sync wird bereits durchgeführt"

#: bookloresync.koplugin/booklore_shelf_sync.lua:80
msgid ""
"Booklore credentials not configured. Please configure your Booklore account "
"first."
msgstr ""
"Booklore-Zugangsdaten nicht konfiguriert. Bitte zuerst Booklore-Konto "
"konfigurieren."

#: bookloresync.koplugin/booklore_shelf_sync.lua:300
msgid "Fetching book list from shelf..."
msgstr "Buchliste vom Regal wird abgerufen..."

#: bookloresync.koplugin/booklore_shelf_sync.lua:387
#: bookloresync.koplugin/booklore_shelf_sync.lua:389
#: bookloresync.koplugin/booklore_shelf_sync.lua:548
msgid "Sync cancelled"
msgstr "Sync abgebrochen"

#: bookloresync.koplugin/booklore_shelf_sync.lua:397
